LN_VOICE_BIND=127.0.0.1
LN_VOICE_PORT=8003
LN_VOICE_INTERNAL_BEARER=
LN_VOICE_SESSION_URL=http://127.0.0.1:9202
LN_VOICE_CALLBACK_BEARER=
# Fake provider is explicitly development-only; never enabled by default.
LN_VOICE_ENABLE_FAKE=false
LN_VOICE_CONCURRENCY=1
LN_VOICE_QUEUE_CAPACITY=8
LN_VOICE_RESULT_TTL_SECONDS=900
LN_VOICE_MAX_RESULT_BYTES=134217728
LN_VOICE_QUEUE_TIMEOUT_SECONDS=10
# Inject these in System and Session when explicitly enabling the executor.
LN_VOICE_URL=http://127.0.0.1:8003
LN_VOICE_ALLOWED_ENDPOINTS=http://127.0.0.1:8003
# Keep bridge until the separately scheduled acceptance/maintenance-window switch.
# All Session instances and ruoyi-voice must use the same explicit route.
LN_VOICE_QWEN_ROUTE=bridge
LN_VOICE_ENABLE_QWEN=false
LN_VOICE_ENABLE_KOKORO=false
LN_VOICE_ENABLE_COSYVOICE3=false
LN_VOICE_KOKORO_URL=http://127.0.0.1:8011
LN_VOICE_COSYVOICE3_URL=http://127.0.0.1:8012
# Health credentials match registered model-service credentials; separate from platform bearers.
LN_VOICE_KOKORO_BEARER=
LN_VOICE_COSYVOICE3_BEARER=
# Exact model URLs must also be appended to LN_VOICE_ALLOWED_ENDPOINTS in System and ruoyi-voice.
# Model runtimes need the exact COS hostname (no wildcard); signed links stay transient.
LN_VOICE_REFERENCE_HOSTS=
LN_VOICE_KOKORO_MODEL_DIR=
LN_VOICE_COSYVOICE3_MODEL_DIR=
