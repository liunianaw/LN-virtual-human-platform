# Copy this file to docker/.env and replace every change_me value locally.
MYSQL_ROOT_PASSWORD=change_me

# Nacos server auth and Java Nacos client credentials.
NACOS_AUTH_TOKEN=change_me
NACOS_AUTH_IDENTITY_KEY=change_me
NACOS_AUTH_IDENTITY_VALUE=change_me
NACOS_USERNAME=nacos
NACOS_PASSWORD=change_me
NACOS_ADDR=ruoyi-nacos:8848

# Platform and session keep separate database URLs and credentials.
PLATFORM_DB_URL=jdbc:mysql://ruoyi-mysql:3306/platform_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
PLATFORM_DB_USER=root
PLATFORM_DB_PASSWORD=change_me
SESSION_DB_URL=jdbc:mysql://ruoyi-mysql:3306/session_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SESSION_DB_USER=root
SESSION_DB_PASSWORD=change_me

# Optional legacy modules, enabled only by their Compose profiles.
LEGACY_DB_URL=jdbc:mysql://ruoyi-mysql:3306/ry-cloud?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
LEGACY_DB_USER=root
LEGACY_DB_PASSWORD=change_me
TOOL_DB_URL=
TOOL_DB_USER=
TOOL_DB_PASSWORD=
MONITOR_USER=admin
MONITOR_PASSWORD=change_me

REDIS_HOST=ruoyi-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ exposes AMQP on host port 5672 and initializes this development vhost.
RABBITMQ_HOST=ruoyi-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=dev
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=/dev_vhost

# COS is optional for M1. Keep its credentials only in the ignored .env file.
COS_REGION=
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=
COS_ENABLED=false
