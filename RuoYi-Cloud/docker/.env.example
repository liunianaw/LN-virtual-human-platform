# Copy to docker/.env. Empty values are intentional: compose must refuse to
# start a service that needs them. Never commit docker/.env.
MYSQL_ROOT_PASSWORD=

# Nacos server auth and Java client credentials (all secret values stay empty).
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
NACOS_USERNAME=nacos
NACOS_PASSWORD=
NACOS_ADDR=ruoyi-nacos:8848

# Platform and session databases are deliberately separate.
PLATFORM_DB_URL=jdbc:mysql://ruoyi-mysql:3306/platform_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
PLATFORM_DB_USER=root
PLATFORM_DB_PASSWORD=
SESSION_DB_URL=jdbc:mysql://ruoyi-mysql:3306/session_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SESSION_DB_USER=root
SESSION_DB_PASSWORD=

# Redis and RabbitMQ are internal Compose services; credentials are required.
REDIS_HOST=ruoyi-redis
REDIS_PORT=6379
REDIS_PASSWORD=
RABBITMQ_HOST=ruoyi-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/dev_vhost

# M2 requires a private COS bucket. COS_ENABLED is fixed to true by Compose.
COS_REGION=
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=

# Media-to-platform internal boundary. The platform URL is non-secret.
RUOYI_MEDIA_INTERNAL_PLATFORM_URL=http://ruoyi-modules-system:9201
RUOYI_MEDIA_WORKER_ID=compose-media-worker
# Required by both system and the media Worker. Set a high-entropy runtime-only
# value; never use a browser JWT or commit it.
RUOYI_MEDIA_INTERNAL_TOKEN=

# Image generation is disabled unless explicitly enabled. Setting true requires
# the runtime-only credential; the media source never reads a local key file.
M2_IMAGE_PROVIDER_ENABLED=false
RUOYI_MEDIA_QWEN_API_KEY=
RUOYI_MEDIA_QWEN_ENDPOINT=https://dashscope.aliyuncs.com

# Official TTS is an external boundary. Keep it explicitly disabled until
# its endpoint and secret are available. An enabled boundary with a blank value
# is rejected by ruoyi-m2-config-gate before system/session/media start.
TTS_ENABLED=false
TTS_PROVIDER_ENDPOINT=
TTS_PROVIDER_API_KEY=

# Optional legacy modules, enabled only with their explicit Compose profiles.
LEGACY_DB_URL=
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
TOOL_DB_URL=
TOOL_DB_USER=
TOOL_DB_PASSWORD=
MONITOR_USER=admin
MONITOR_PASSWORD=
